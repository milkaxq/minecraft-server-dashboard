APP_ENV=development
# Replace both placeholders with the same URL-safe local password before starting.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://hosting:replace-with-local-password@postgres:5432/hosting?sslmode=disable
FRONTEND_ORIGIN=http://localhost:3000
# Browser-reachable API URL; Next.js embeds this at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
HTTP_ADDR=:8080
MAIL_DIRECTORY=.local/mail
# Production: implicit TLS SMTP, generally port 465. Never commit credentials.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Redis remains available for future cache/notifications; jobs use PostgreSQL.
REDIS_URL=redis://redis:6379/0
# Enable the pterodactyl Compose profile only after configuring an external Panel.
PTERODACTYL_URL=
PTERODACTYL_APPLICATION_API_KEY=
# Backend-only Client API key from a dedicated Panel operator account. Never reuse the Application key.
PTERODACTYL_CLIENT_API_KEY=

# Exact Wings socket origins, comma-separated. Production requires wss://.
# Example: wss://wings.example.com:8080
PTERODACTYL_WEBSOCKET_ORIGINS=

# Exact HTTPS origins for signed file/backup transfers (Wings and optional S3).
# Example: https://wings.example.com:8080,https://bucket.s3.example.com
PTERODACTYL_TRANSFER_ORIGINS=

# Development-only mock checkout. Generates no real charges. Enable explicitly.
PAYMENT_PROVIDER=disabled
# Set with: openssl rand -hex 32 (never commit the generated value).
MOCK_PAYMENT_SECRET=

# Optional containerized Pterodactyl v2 development stack (see docs/PTERODACTYL_V2.md).
# Panel needs MariaDB in addition to the hosting application's PostgreSQL.
PANEL_DATABASE_PASSWORD=
PANEL_DATABASE_ROOT_PASSWORD=
PANEL_PUBLIC_URL=http://localhost:8090
